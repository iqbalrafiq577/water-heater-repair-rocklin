const post = getPost('water-heater-permit-california');

const faqs = [
  { q: 'Do you really need a permit to replace a water heater in California?',
    a: 'Yes. Replacing a water heater is permitted work in California because it involves gas or electrical supply, pressurised hot water and a combustion appliance. Your local building department issues the permit and an inspector signs the job off.' },
  { q: 'Who pulls the permit — me or the plumber?',
    a: 'Normally the licensed contractor doing the work pulls it, and the cost is included in the quote. If someone offers to do the job cheaper by leaving the permit out, that is the part of the price you should be most suspicious of.' },
  { q: 'What happens if a water heater was installed without a permit?',
    a: 'Nothing immediately — which is why it is common. The problems surface later: at resale when a buyer or their inspector asks for records, on an insurance claim after water or fire damage, or when a future permit application brings the unpermitted work to light.' },
  { q: 'Can an unpermitted water heater be made legal afterwards?',
    a: 'Usually, yes. The building department can generally permit existing work retroactively, but the installation has to be brought up to current code first and anything concealed may need to be opened up for inspection. It is almost always more expensive than doing it right the first time.' },
  { q: 'Does the inspector need access to the water heater?',
    a: 'Yes. The inspector needs to see the unit, its connections, the venting and the relief valve discharge. Keep the area clear and accessible — a garage packed to the ceiling is the most common reason an inspection has to be rescheduled.' },
];
---
