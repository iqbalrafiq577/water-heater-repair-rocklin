---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact Us', href: '/contact-us' },
];

const contactPage = {
  '@type': 'ContactPage',
  '@id': `${site.url}/contact-us#webpage`,
  url: `${site.url}/contact-us`,
  name: `Contact ${site.name} — Water Heater Repair in Rocklin, CA`,
  description: `Call, email or message ${site.name} for water heater repair, replacement, installation and maintenance in Rocklin, California. Open 24/7 for emergencies.`,
  inLanguage: 'en-US',
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#business` },
  mainEntity: { '@id': `${site.url}/#business` },
  significantLink: [
    `${site.url}/water-heater-leak-repair-rocklin`,
    `${site.url}/water-heater-replacement-rocklin`,
  ],
};

const schema = [contactPage, breadcrumbSchema(crumbs)];

const unitTypes = [
  'Gas tank water heater',
  'Electric tank water heater',
  'Tankless water heater',
  'Heat pump / hybrid water heater',
  'Not sure',
];
---
<Base
  title="Contact Us | Water Heater Repair in Rocklin, CA"
  description="Contact our Rocklin, CA water heater team — phone, email, address and hours, plus a booking form. Open 24/7 for water heater emergencies."
  path="/contact-us"
  schema={schema}
>
  <Hero
    h1="Contact Us"
    lede="Call for anything urgent — no hot water, a leak, a tankless error code. For everything else, send the form below and we will come back to you with a time and a price."
    points={['Phones answered 24/7','Same-day appointments','Written price before work','Licensed & insured']}
    form={false}
    center
  />

  <Breadcrumbs items={crumbs} />

  <section class="section">
    <div class="wrap">
      <div class="grid grid--3">
        <article class="card">
          <h3>Phone</h3>
          <p>
            <a href={site.phoneHref}><strong>{site.phone}</strong></a><br />
            Fastest way to reach us, and the only way to reach us for an emergency.
          </p>
        </article>
        <article class="card">
          <h3>Email</h3>
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a><br />
            Good for photos, data plate pictures, quotes and invoices. Not monitored overnight.
          </p>
        </article>
        <article class="card">
          <h3>Service area</h3>
          <p>All of Rocklin ({site.zips.join(' and ')}) plus {site.nearbyCities.map((c) => c.name).join(', ')}. Not sure if you are in range? Call and ask.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2>Request an Appointment or an Estimate</h2>
      <p>
        Send us the basics and we will reply with an arrival window and the diagnostic fee, or with a
        written estimate if you already know what you need. If your water heater is leaking right now,
        please call instead of using the form.
      </p>

      <!--
        ================================================================
        DEVELOPER NOTE — THIS FORM IS NOT WIRED UP YET.
        The action is deliberately set to "#" so nothing is submitted
        anywhere and no lead is silently lost. BEFORE LAUNCH, point the
        action at the client's real form handler, email service or CRM
        endpoint (for example Netlify Forms, Formspree, HubSpot or their
        own API route), set the correct method, add the provider's spam
        protection / honeypot field, and add a thank-you or success state.
        Then submit a live test inquiry and confirm it arrives in the
        client's inbox or CRM before the site goes public.
        ================================================================
      -->
      <form class="card" action="#" method="post" style="margin-top:22px;display:grid;gap:12px;max-width:560px">
        <div style="display:grid;gap:4px">
          <label for="contact-name" style="font-weight:700;font-size:.9rem">Your name <span aria-hidden="true">*</span></label>
          <input id="contact-name" name="name" type="text" required autocomplete="name"
            style="padding:7px 10px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:.92rem;width:100%" />
        </div>

        <div style="display:grid;gap:4px">
          <label for="contact-phone" style="font-weight:700;font-size:.9rem">Phone number <span aria-hidden="true">*</span></label>
          <input id="contact-phone" name="phone" type="tel" required autocomplete="tel"
            style="padding:7px 10px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:.92rem;width:100%" />
        </div>

        <div style="display:grid;gap:4px">
          <label for="contact-email" style="font-weight:700;font-size:.9rem">Email address <span aria-hidden="true">*</span></label>
          <input id="contact-email" name="email" type="email" required autocomplete="email"
            style="padding:7px 10px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:.92rem;width:100%" />
        </div>

        <div style="display:grid;gap:4px">
          <label for="contact-address" style="font-weight:700;font-size:.9rem">Service address <span aria-hidden="true">*</span></label>
          <input id="contact-address" name="address" type="text" required autocomplete="street-address"
            style="padding:7px 10px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:.92rem;width:100%" />
        </div>

        <div style="display:grid;gap:4px">
          <label for="contact-unit" style="font-weight:700;font-size:.9rem">Type of water heater <span aria-hidden="true">*</span></label>
          <select id="contact-unit" name="unit_type" required
            style="padding:7px 10px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:.92rem;width:100%;background:#fff">
            <option value="">Please choose one</option>
            {unitTypes.map((u) => <option value={u}>{u}</option>)}
          </select>
        </div>

        <div style="display:grid;gap:4px">
          <label for="contact-message" style="font-weight:700;font-size:.9rem">What is happening? <span aria-hidden="true">*</span></label>
          <textarea id="contact-message" name="message" rows="3" required
            style="padding:7px 10px;border:1px solid var(--line);border-radius:6px;font:inherit;font-size:.92rem;width:100%"></textarea>
        </div>

        <div>
          <button class="btn" type="submit">Send my request</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Find Us in {site.address.city}, {site.address.region}</h2>
      <div style="margin-top:18px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line)">
        <iframe
          title={`Map of ${site.name} in ${site.address.city}, ${site.address.region}`}
          src={`https://maps.google.com/maps?q=${site.geo.lat},${site.geo.lng}&z=13&output=embed`}
          width="100%"
          height="400"
          style="border:0;display:block"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Base>
