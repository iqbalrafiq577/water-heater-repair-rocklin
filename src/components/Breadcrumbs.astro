---
export interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    <ol>
      {items.map((i, n) => (
        <li>{i.href && n < items.length - 1 ? <a href={i.href}>{i.name}</a> : <span aria-current="page">{i.name}</span>}</li>
      ))}
    </ol>
  </div>
</nav>
