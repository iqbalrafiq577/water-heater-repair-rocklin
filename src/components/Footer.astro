---
import { site } from '../data/site';
import { services, company } from '../data/nav';
const year = 2026;
---
<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h3>{site.name}</h3>
        <p>Water heater repair, replacement and installation for homes across Rocklin, California. Tank, tankless and heat pump units.</p>
        <p>
          Licensed, bonded &amp; insured
        </p>
      </div>
      <div>
        <h3>Services</h3>
        <ul>{services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          {company.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</li>
          <li>{site.hours}</li>
        </ul>
        <h3 style="margin-top:18px">Areas Covered</h3>
        <p style="margin:0">Rocklin ({site.zips.join(', ')}), {site.nearbyCities.map((c) => c.name).join(', ')}.</p>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <span>Rocklin, CA water heater specialists.</span>
    </div>
  </div>
</footer>
