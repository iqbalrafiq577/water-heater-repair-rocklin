---
import { site } from '../data/site';
export interface Props {
  kicker?: string; heading?: string; intro?: string;
  items: { q: string; a: string }[];
}
const {
  kicker = 'FAQs',
  heading = 'Water Heater Questions We Get Asked Most',
  intro = 'The questions Rocklin homeowners and landlords ask most before they book.',
  items,
} = Astro.props;
---
<section class="section section--alt" id="faq">
  <div class="wrap">
    <div class="sec-center">
      <p class="eyebrow">{kicker}</p>
      <h2>{heading}</h2>
      <p>{intro}</p>
    </div>
    <div class="faqgrid">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary>
            <span class="qn">{String(i + 1).padStart(2, '0')}</span>
            <span>{f.q}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <div class="ans"><p set:html={f.a} /></div>
        </details>
      ))}
    </div>
    <div class="faqhelp">
      <div>
        <h3>Still not sure what your heater is doing?</h3>
        <p>Describe the symptom and we will tell you what it usually means before anyone drives out.</p>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn" href={site.phoneHref}>Call {site.phone}</a>
        <a class="btn btn--ghost" href="/contact-us">Ask a question</a>
      </div>
    </div>
  </div>
</section>
