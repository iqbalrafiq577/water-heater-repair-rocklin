---
export interface Props { kicker?: string; heading: string; img: string; alt: string; reverse?: boolean }
const { kicker = 'About us', heading, img, alt, reverse = false } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class={`imgcopy${reverse ? ' imgcopy--rev' : ''}`}>
      <div class="imgcopy__media">
        <img src={img} alt={alt} width="1500" height="1000" loading="lazy" decoding="async" />
      </div>
      <div class="imgcopy__body">
        <p class="eyebrow">{kicker}</p>
        <h2>{heading}</h2>
        <slot />
      </div>
    </div>
  </div>
</section>
