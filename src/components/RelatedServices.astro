---
import { services } from '../data/nav';
export interface Props { exclude?: string; kicker?: string; heading?: string; limit?: number }
const { exclude = '', kicker = 'More services', heading = 'Related Services', limit = 4 } = Astro.props;
const list = services.filter((s) => s.href !== exclude).slice(0, limit);
---
<section class="section">
  <div class="wrap">
    <p class="kicker">{kicker}</p>
    <h2>{heading}</h2>
    <ul class="problems__rows" style="border-top-color:var(--line);margin-top:26px">
      {list.map((s, i) => (
        <li style="border-bottom-color:var(--line)">
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 style="color:var(--navy)"><a href={s.href} style="text-decoration:none;color:inherit">{s.label}</a></h3>
            <p style="color:var(--muted)">{s.short}</p>
          </div>
          <a class="arr" href={s.href} aria-label={s.label}>↗</a>
        </li>
      ))}
    </ul>
  </div>
</section>
