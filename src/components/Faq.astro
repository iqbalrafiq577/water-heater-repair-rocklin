---
export interface Props { heading?: string; items: { q: string; a: string }[]; intro?: string }
const { heading = 'Water Heater Questions We Get Asked Most', items, intro } = Astro.props;
---
<section class="section section--alt faq" id="faq">
  <div class="wrap">
    <h2>{heading}</h2>
    {intro && <p>{intro}</p>}
    {items.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <div class="ans"><p set:html={f.a} /></div>
      </details>
    ))}
  </div>
</section>
