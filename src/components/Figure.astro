---
// Responsive, lazy-loaded image with an explicit aspect ratio so the browser
// reserves space and we avoid layout shift (CLS). Alt text is required.
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  eager?: boolean;
}
const { src, alt, width, height, caption, eager = false } = Astro.props;
---
<figure style="margin:0 0 28px">
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
    style={`width:100%;height:auto;aspect-ratio:${width} / ${height};object-fit:cover;border-radius:12px;border:1px solid var(--line);max-height:430px`}
  />
  {caption && <figcaption class="note" style="margin-top:8px">{caption}</figcaption>}
</figure>
